# GameAP Environment Configuration
# Copy this file to .env and update the values

# Security - REQUIRED IN PRODUCTION
# Generate strong random values for these keys
ENCRYPTION_KEY=change-me-to-random-32-char-key
AUTH_SECRET=change-me-to-random-32-char-secret

# Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8025

# Database Configuration
# Options: mysql, postgres, sqlite, inmemory
DATABASE_DRIVER=postgres

# PostgreSQL example
DATABASE_URL=postgres://gameap:gameap@postgres:5432/gameap?sslmode=disable
POSTGRES_PASSWORD=gameap

# MySQL example (comment out PostgreSQL and uncomment these)
# DATABASE_URL=gameap:gameap@tcp(mysql:3306)/gameap?parseTime=true
# MYSQL_PASSWORD=gameap
# MYSQL_ROOT_PASSWORD=rootpassword

# SQLite example (comment out PostgreSQL and uncomment this)
# DATABASE_URL=file:/var/lib/gameap/db.sqlite?_busy_timeout=5000&_journal_mode=WAL&cache=shared

# How long to retry the initial database connect at startup before giving up
# DATABASE_CONNECT_TIMEOUT=30s

# Cache Configuration
CACHE_DRIVER=redis
CACHE_REDIS_ADDR=redis:6379

# For in-memory cache (no Redis needed):
# CACHE_DRIVER=memory

# File Storage
FILES_DRIVER=local
FILES_LOCAL_BASE_PATH=/var/lib/gameap/files

# S3 Storage (uncomment to use S3)
# FILES_DRIVER=s3
# FILES_S3_ENDPOINT=https://s3.amazonaws.com
# FILES_S3_ACCESS_KEY_ID=your-access-key
# FILES_S3_SECRET_ACCESS_KEY=your-secret-key
# FILES_S3_BUCKET=gameap-files
# FILES_S3_REGION=us-east-1

# Logging
LOGGER_LEVEL=info

# Authentication
AUTH_SERVICE=paseto

# Allow weak passwords (skip the embedded common-password blocklist).
# Leaving this false is strongly recommended (OWASP ASVS 4.0.3 §2.1.7).
# When set to true, a startup warning is logged and password creation /
# change endpoints stop rejecting passwords from the SecLists top-1M list.
# Length checks (min 12 / max 128) still apply.
# AUTH_ALLOW_WEAK_PASSWORDS=false

# Require admins (accounts with the admin ability) to enable two-factor auth.
# Enabled by default: an admin without 2FA is nudged on every login/refresh,
# and after AUTH_MFA_HARD_FAIL_DAYS the login issues only an enrollment-scoped
# session until 2FA is set up. Set to false to disable the behaviour entirely;
# switching to false also unlocks any still-valid enrollment-scoped sessions.
# AUTH_REQUIRE_MFA_FOR_ADMINS=true
# Grace period (days) from the first nudge to the hard-fail lockout. Set to 0
# to keep the nudge as a non-blocking reminder (no enrollment lockout).
# AUTH_MFA_HARD_FAIL_DAYS=30

# RBAC
RBAC_CACHE_TTL=30s

# Plugins
# A plugin that fails to load is recorded with status "error" and skipped;
# set to true to make the panel refuse to start instead.
# PLUGINS_STRICT_LOAD=false
# Local directory for the compiled-wasm cache (survives restarts).
# PLUGINS_CACHE_DIR=
# Sizes accept a unit suffix: 512K, 64M, 1G (plain numbers are bytes).
# Memory cap per plugin module (0 = 4 GiB wazero default).
# PLUGIN_RUNTIME_MAX_MEMORY=256M
# Largest wasm file accepted for install/load (0 = unlimited).
# PLUGIN_RUNTIME_MAX_MODULE_SIZE=128M
# Apply the recorded plugin permission grants. Off for this release so plugins
# written before grants existed keep working while operators record theirs;
# a future release will turn it on by default. Grants are recorded, shown and
# editable either way.
# PLUGIN_PERMISSIONS_ENFORCE=false
# How long a plugin's granted permissions stay cached in memory. Changes are
# pushed to every instance over pub/sub, so this only bounds the drift when the
# broker is unreachable; 0 reads the plugin record on every check.
# PLUGIN_PERMISSIONS_CACHE_TTL=30s
# Automatic reload of plugins disabled at runtime (timeouts, guest exit).
# PLUGIN_RECOVERY_ENABLED=true
# PLUGIN_RECOVERY_INITIAL_DELAY=30s
# PLUGIN_RECOVERY_MAX_DELAY=10m
# PLUGIN_RECOVERY_MAX_ATTEMPTS=5
# Largest file a plugin may download/upload in one gameap-nodefs call.
# PLUGIN_NODEFS_MAX_INLINE=32M
# Where plugins may point node file operations, command working directories
# and file references: unrestricted | node_workpath | server_dirs.
# ".." segments are refused in every mode.
# PLUGIN_NODEFS_PATH_POLICY=unrestricted
# Extra absolute roots allowed on top of a restricted policy (comma-separated).
# PLUGIN_NODEFS_ALLOWED_PATHS=
# Multi-instance plugin sync: every instance applies plugin changes made on
# the others (pubsub hint + periodic pass; failed loads are retried with backoff).
# PLUGIN_SYNC_DISABLED=false
# PLUGIN_SYNC_REFRESH_INTERVAL=60s
# PLUGIN_SYNC_MIN_BACKOFF=15s
# PLUGIN_SYNC_MAX_BACKOFF=15m
# gameap-storage quotas per plugin.
# PLUGIN_STORAGE_MAX_KEYS_PER_PLUGIN=10000
# PLUGIN_STORAGE_MAX_VALUE=1M
# PLUGIN_STORAGE_MAX_TOTAL=64M
# Largest gameap-cache value (0 = unlimited).
# PLUGIN_CACHE_MAX_VALUE=1M
# gameap-secrets quotas per plugin; REQUIRE_ENCRYPTION also covers
# "format: secret" configuration values.
# PLUGIN_SECRETS_MAX_KEYS_PER_PLUGIN=64
# PLUGIN_SECRETS_MAX_VALUE=8K
# PLUGIN_SECRETS_REQUIRE_ENCRYPTION=true
# gameap-http / plugin network ceilings.
# PLUGIN_HTTP_MAX_TIMEOUT=30s
# PLUGIN_NET_MAX_TIMEOUT=10s
# PLUGIN_NET_READ_BUFFER=64K
# Per-plugin, per-instance token buckets on the expensive host libraries
# (sustained calls per second / burst; RPS 0 = no limit).
# PLUGIN_RATELIMIT_NODECMD_RPS=5
# PLUGIN_RATELIMIT_NODECMD_BURST=20
# PLUGIN_RATELIMIT_SERVERCONTROL_RPS=5
# PLUGIN_RATELIMIT_SERVERCONTROL_BURST=20
# PLUGIN_RATELIMIT_NODEFS_RPS=50
# PLUGIN_RATELIMIT_NODEFS_BURST=200
# PLUGIN_RATELIMIT_HTTP_RPS=20
# PLUGIN_RATELIMIT_HTTP_BURST=50
# PLUGIN_RATELIMIT_RBAC_RPS=10
# PLUGIN_RATELIMIT_RBAC_BURST=50

# Metrics
# Bearer token for GET /metrics (Prometheus); empty = endpoint disabled.
# METRICS_TOKEN=

# Build metadata (for docker-compose build)
BUILD_DATE=2025-01-01T00:00:00Z
